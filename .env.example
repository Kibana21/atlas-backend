# Local development settings (copy to .env; never commit .env). Placeholders only.
# Uses the owner's existing PostgreSQL 15 and Redis (ATLAS-001 spec §6.1-6.3).
ATLAS_ENV=local
ATLAS_DATABASE_URL=postgresql+psycopg://atlas_app:change-me@localhost:5432/atlas_db
ATLAS_MIGRATION_DATABASE_URL=postgresql+psycopg://atlas_migrator:change-me@localhost:5432/atlas_db
ATLAS_DB_APP_ROLE=atlas_app
ATLAS_REDIS_URL=redis://localhost:6379/10
ATLAS_REDIS_KEY_PREFIX=atlas:local:
ATLAS_CORS_ORIGINS=http://localhost:3000
ATLAS_DIAGNOSTICS_ENABLED=true
ATLAS_LOG_LEVEL=INFO
# Read-only metadata session used only by `make doctor` (no Atlas role needed). Optional.
ATLAS_DOCTOR_METADATA_URL=postgresql://localhost:5432/postgres
# ATLAS-002 ingestion role: created by the server owner at gate G3-R; uncomment then. The API never reads these.
# ATLAS_INGEST_DATABASE_URL=postgresql+psycopg://atlas_ingest:change-me@localhost:5432/atlas_db
# ATLAS_DB_INGEST_ROLE=atlas_ingest
