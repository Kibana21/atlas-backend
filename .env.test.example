# Test settings (copy to .env.test; never commit). Placeholders only.
ATLAS_ENV=test
ATLAS_DATABASE_URL=postgresql+psycopg://atlas_test_app:change-me@localhost:5432/atlas_test
ATLAS_MIGRATION_DATABASE_URL=postgresql+psycopg://atlas_test_migrator:change-me@localhost:5432/atlas_test
ATLAS_DB_APP_ROLE=atlas_test_app
ATLAS_REDIS_URL=redis://localhost:6379/11
ATLAS_REDIS_KEY_PREFIX=atlas:test:
ATLAS_CORS_ORIGINS=http://localhost:3000
ATLAS_DIAGNOSTICS_ENABLED=true
# ATLAS-002 ingestion role: created by the server owner at gate G3-R; uncomment then. The API never reads these.
# ATLAS_INGEST_DATABASE_URL=postgresql+psycopg://atlas_test_ingest:change-me@localhost:5432/atlas_test
# ATLAS_DB_INGEST_ROLE=atlas_test_ingest
# Single-user model (owner decision, 25 Oct 2026; local and test only): one account for every role instead of the
# separated roles above. Uncomment and set all three URLs to the same user (the password is not verified under local trust auth).
# The owner's local atlas_db_user is a PostgreSQL SUPERUSER: database privileges then separate nothing.
# ATLAS_DB_ROLE_MODEL=single
# ATLAS_DATABASE_URL=postgresql+psycopg://atlas_db_user:change-me@localhost:5432/atlas_test
# ATLAS_MIGRATION_DATABASE_URL=postgresql+psycopg://atlas_db_user:change-me@localhost:5432/atlas_test
# ATLAS_DB_APP_ROLE=atlas_db_user
